# Веб-аналитика (опционально).
# Скопируйте этот файл в .env.local и укажите номера своих счётчиков.
# Если переменные не заданы — аналитика не подключается вовсе.

# Номер счётчика Яндекс.Метрики (только цифры), например: 12345678
VITE_YM_ID=

# Идентификатор Google Analytics 4, например: G-XXXXXXXXXX
VITE_GA_ID=
